# ═══════════════════════════════════════════════════════════
# WealthWise AI — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file as .env.local and fill in your values
# Command: cp .env.example .env.local

# ─── Supabase (Google OAuth via Supabase Auth) ───────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Google Gemini AI ────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── Turso Cloud Database (libSQL) ──────────────────────
# Get from: https://turso.tech → Create database → Get credentials
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── JWT Secret ──────────────────────────────────────────
# Generate a strong random string (min 32 chars)
JWT_SECRET=your-strong-random-secret-key-here

# ─── Cloudflare Turnstile CAPTCHA ───────────────────────
# Get from: https://dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── Admin Panel ────────────────────────────────────────
# Credentials for the admin dashboard
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-admin-password

# ─── Optional: Resend (Email OTP delivery) ─────────────
# Get from: https://resend.com → API Keys
# RESEND_API_KEY=re_xxxxxxxx
